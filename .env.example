# Скопіюй у .env і заповни. Порожні рядки — значення за замовчуванням.

# Домен, на якому відкриваєш чат у браузері (без https://). Потрібен для ключів доступу (Face ID),
# посилань «Поділитися» і пушів. Для доступу з телефона — домен з HTTPS: Cloudflare Tunnel, Caddy, nginx.
# За замовчуванням localhost (лише цей комп'ютер).
PUBLIC_HOST=chat.example.com
# PUBLIC_URL=https://chat.example.com     # якщо адреса не https://PUBLIC_HOST

# Порт і адреса сервера чату. Проксі чи тунель ведуть на 127.0.0.1:PORT.
# PORT=5190
# BIND_HOST=127.0.0.1

# Де живе Hermes Agent (як HERMES_HOME у самого Hermes).
# HERMES_HOME=~/.hermes
# HERMES_AGENT_DIR=~/.hermes/hermes-agent
# HERMES_PYTHON=~/.hermes/hermes-agent/venv/bin/python
# HERMES_URL=http://127.0.0.1:8642        # API-сервер Hermes

# Дані чату (база, файли, ключі). За замовчуванням ./data
# DATA_DIR=./data

# Логін і пароль (створює npm run setup). За замовчуванням ./config.yaml
# CHAT_CONFIG=./config.yaml

# Сховище Obsidian для бази знань. За замовчуванням — OBSIDIAN_VAULT_PATH із .env Hermes.
# VAULT_PATH=/path/to/vault

# Лише якщо чат запускає менеджер процесів, що зупиняє його після простою і піднімає на запит.
# Поки Hermes працює над задачею, чат раз на 5 хв стукає до себе через нього, щоб його не зупинили.
# ROUTER_URL=http://127.0.0.1:8000

# Контакт для служб пушів (mailto: або https). За замовчуванням — адреса чату.
# VAPID_SUBJECT=mailto:you@example.com
