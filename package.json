{
  "name": "hermes-agent-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A private ChatGPT-style web chat for Hermes Agent: native gateway protocol, scheduled tasks, Obsidian knowledge base, passkeys and push notifications.",
  "license": "MIT",
  "keywords": [
    "hermes-agent",
    "chat",
    "ai-agent",
    "self-hosted",
    "pwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taral14/hermes-agent-chat.git"
  },
  "homepage": "https://github.com/taral14/hermes-agent-chat#readme",
  "bugs": "https://github.com/taral14/hermes-agent-chat/issues",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.ts",
    "doctor": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/doctor.ts",
    "setup:hermes": "sh scripts/install-hermes-plugin.sh",
    "setup:vault-mirror": "sh scripts/install-vault-mirror.sh",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint src server scripts test",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
