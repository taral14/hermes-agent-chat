{
  "name": "chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Власний веб-чат для Hermes Agent: React, Node і SQLite, рідний протокол Hermes.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "doctor": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/doctor.ts",
    "setup:hermes": "sh scripts/install-hermes-plugin.sh",
    "setup:vault-mirror": "sh scripts/install-vault-mirror.sh",
    "lint": "oxlint"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
